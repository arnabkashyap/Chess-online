# ─────────────────────────────────────────────────────────────────────────────
# Element Chess — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real credentials.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Project URL
# Found in: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous (Public) Key
# Found in: Supabase Dashboard → Project Settings → API → anon public key
# This key is safe to expose in the browser — RLS policies control access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY — Optional
# ─────────────────────────────────────────────────────────────────────────────
# Service Role Key — gives full database access, bypassing RLS.
# ONLY use in server-side scripts/functions. NEVER prefix with NEXT_PUBLIC_.
# Found in: Supabase Dashboard → Project Settings → API → service_role key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────────────────────────────────────
# OAUTH PROVIDERS — Configure in Supabase Dashboard
# ─────────────────────────────────────────────────────────────────────────────
# Google: Dashboard → Authentication → Providers → Google
#   - Client ID and Secret from Google Cloud Console
#   - Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
#
# Facebook: Dashboard → Authentication → Providers → Facebook
#   - App ID and Secret from Meta Developer Portal
#   - Valid OAuth Redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
#
# Anonymous Sign-In (Guest): Dashboard → Authentication → Providers → Anonymous
#   - Enable the "Allow anonymous sign-ins" toggle
